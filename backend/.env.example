# ============================================================
# Cenli DPE Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# Google Gemini
# ------------------------------------------------------------
# Your Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------
# Arize Phoenix (local self-hosted)
# ------------------------------------------------------------
# Leave these as-is when running Phoenix locally with Docker.
# The collector endpoint receives OTLP traces from the agent.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# Your Phoenix API key — only required for Phoenix Cloud.
# Leave blank (or omit entirely) for local Phoenix.
PHOENIX_API_KEY=

# ------------------------------------------------------------
# FastAPI server (optional overrides)
# ------------------------------------------------------------
# Host and port for the uvicorn dev server.
HOST=0.0.0.0
PORT=8000

# Set to "production" in deployed environments.
ENV=development
