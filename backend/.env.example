# ============================================================
# Cenli DPE Backend — Environment Variables
# ============================================================
# 1. Copy this file:   cp .env.example .env
# 2. Fill in the values
# 3. NEVER commit .env to version control
# ============================================================

# ── KEY 1 ───────────────────────────────────────────────────
# Google Gemini API Key
# Get it: https://aistudio.google.com/apikey (free)
# Powers: all Gemini calls (refactor agent + LLM-as-a-Judge)
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── KEY 2 ───────────────────────────────────────────────────
# Arize Phoenix API Key
# Get it: https://app.phoenix.arize.com → Settings → API Keys (free tier)
# Powers: sends traces to Phoenix Cloud + authenticates phoenix-mcp
#
# Leave blank → uses local Docker Phoenix (http://localhost:6006)
# ─────────────────────────────────────────────────────────────
PHOENIX_API_KEY=your_phoenix_api_key_here

# OTLP collector endpoint (auto-set from PHOENIX_API_KEY if left blank)
# Cloud:  https://app.phoenix.arize.com/v1/traces
# Local:  http://localhost:6006/v1/traces
PHOENIX_COLLECTOR_ENDPOINT=

# Phoenix base URL for the MCP server (auto-set from PHOENIX_API_KEY)
# Cloud:  https://app.phoenix.arize.com
# Local:  http://localhost:6006
PHOENIX_BASE_URL=

# ── KEY 3 (for Cloud Run deployment only) ───────────────────
# Google Cloud Project ID
# Get it: https://console.cloud.google.com → Project selector
# Powers: Cloud Run deployment (gcloud run deploy)
# ─────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here

# ── SERVER ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ENV=development
